# PHARVO backend configuration.
# Copy this file to `.env` at the repository root and fill in real values:
#   copy .env.example .env
#
# NONE of these values are read by default — every Django command requires
# DB_PASSWORD (and optionally a stable DJANGO_SECRET_KEY) to be present in the
# environment. `.env` is gitignored and must never be committed.

# Database connection (your LOCAL PostgreSQL service on localhost:5432).
# Set DB_PASSWORD to the password of your local `postgres` superuser so that
# `scripts/restore_db.ps1` and the Django backend can connect.
DB_NAME=pharvo_db
DB_USER=postgres
DB_PASSWORD=change-me-to-your-local-postgres-password
DB_HOST=localhost
DB_PORT=5432

# Django
DJANGO_DEBUG=True
# Generate your own:  python -c "import secrets; print(secrets.token_urlsafe(50))"
# (If unset, a random development key is generated per-process.)
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1